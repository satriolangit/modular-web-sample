{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite.module.config.ts", "vitest.config.ts", "aliases.cjs"]
}
