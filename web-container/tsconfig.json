{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@arsi/container": ["./src/public/index.ts"],
      "@arsi/shared": ["../web-modules/shared/index.ts"],
      "@arsi/module-*/entry": ["../web-modules/modules/*/index.tsx"],
      "@arsi/module-*": ["../web-modules/modules/*/public.ts"],
      "@arsi/extension": ["./current-client/src/index.tsx"]
    }
  },
  "include": ["src"]
}
