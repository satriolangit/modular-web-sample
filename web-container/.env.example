# Sample dev environment — copy: cp .env.example .env  (.env gitignored)
# Client identity; optional. If unset, the current-client symlink is used.
# Accepts suffix or full id: bca / client-bca / web-extension-client-bca / base.
# VITE_CLIENT=client-bca

# Modules initialized at boot (CSV; names must exist in the build).
VITE_MODULES=user-management,product-management,module-sample

# API base for deps.api and module services.
VITE_API_BASE=https://dummyjson.com

# Feature flag.
VITE_ENABLE_AUDIT_LIVE=true

# Full /config.json override (JSON object). When set, the values above are ignored.
# VITE_CONFIG_JSON={"client":"client-bca","modules":["user-management"],"apiBase":"https://api.example.com","featureFlags":{"enableAuditLive":false}}
