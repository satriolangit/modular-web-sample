{
  "name": "web-container",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:modules": "node scripts/generate-module-loaders.mjs",
    "predev:client-a": "npm run gen:modules",
    "dev:client-a": "vite",
    "prebuild:client-a": "npm run gen:modules",
    "build:client-a": "vite build --outDir dist/client-a",
    "preview": "vite preview",
    "link:client-a": "ln -sfn ../web-extension-client-a current-client",
    "pretypecheck": "npm run gen:modules",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "pretest": "npm run gen:modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "check:dockerfile": "node scripts/check-dockerfile-modules.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-query": "^5.103.2",
    "axios": "~1.7.9",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
